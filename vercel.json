{
  "version": 2,
  "functions": {
    "api/index.py": {
      "runtime": "vercel-python@3.1.0",
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "PYTHONPATH": ".",
    "APP_ENV": "production",
    "DEBUG": "false"
  }
}
