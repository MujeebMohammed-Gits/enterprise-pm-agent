{
  "version": 2,
  "functions": {
    "app/main.py": {
      "runtime": "python3.11",
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ],
  "env": {
    "PYTHONPATH": ".",
    "APP_ENV": "production",
    "DEBUG": "false"
  }
}
