# Environment Variables Template
# Copy this to .env and fill in your values

# Application Settings
APP_NAME=Enterprise PM Agent
APP_VERSION=1.0.0
APP_ENV=development  # development, staging, production
DEBUG=false

# Server Settings
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database Settings
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/epma
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Redis Settings (for caching and pub/sub)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Security Settings
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Email Settings (for notifications)
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=smtp.example.com
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME=Enterprise PM Agent

# AI Settings
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
AI_MODEL_PROVIDER=openai  # openai, anthropic, google
AI_MODEL_NAME=gpt-4-turbo-preview
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.7

# Integration Settings
JIRA_BASE_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
AZURE_DEVOPS_ORGANIZATION=
AZURE_DEVOPS_PERSONAL_ACCESS_TOKEN=
SERVICENOW_INSTANCE=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SAP_CLIENT=
SAP_USER=
SAP_PASSWORD=
SAP_LANGUAGE=EN
GITHUB_TOKEN=
GITLAB_TOKEN=
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=

# Feature Flags
FEATURE_WORKFLOW_ENGINE=true
FEATURE_CUSTOM_FIELDS=true
FEATURE_AI_ASSISTANT=true
FEATURE_ADVANCED_REPORTING=true
FEATURE_INTEGRATION_SYNC=true
FEATURE_NOTIFICATIONS=true
FEVENT_AUDIT_LOGGING=true
FEATURE_RATE_LIMITING=true
FEATURE_CACHING=true

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
LOG_LEVEL=INFO